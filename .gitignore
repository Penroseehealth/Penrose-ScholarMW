# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environment
.env
*.db
*.sqlite3

# Media uploads
media/
!media/.gitkeep

# ChromaDB data
chroma_data/

# Node (for tooling)
node_modules/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Flutter
frontend/.dart_tool/
frontend/build/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies

# Local web build served by the dev proxy
tools/build/
*.log

# Stale committed Flutter build copy (regenerated by flutter build web)
backend/static/

# Local LiveKit server binary (large; distributed via release/LFS instead)
tools/livekit-server/livekit-server.exe

# Scratch command output (ad-hoc flutter analyze/test/build captures)
scratch_*.txt
*_final.txt
build_web.txt
# Captured stdout/stderr from ad-hoc server and build runs
*.err
*.out

# Extracted Z-Anatomy source atlas (downloaded; ~500 MB, regenerated by tools/anatomy_pipeline)
tools/z-anatomy-src/

# Secrets (never commit)
.env.prod
.env.*

# Compressed-asset rollback copies (originals; 215MB each)
frontend/web/biology_lab/assets/_orig_backup/

# Local run logs
backend/uvicorn.err
backend/uvicorn.out

# Harvested MANEB MSCE past papers (large PDFs, regenerated by
# tools/harvest_msce_papers.py; the manifest in backend/data/msce_papers is tracked)
backend/data/msce_papers/papers/
backend/data/msce_papers/cache/
tools/_msce_raw/

# Asymptote diagram service cache (regenerated renders + execution logs)
backend/generated/

# interrupted sqlite journal from test runs
backend/test.db-journal

# Voice Training Centre system-audio recordings (local capture data, may be large)
backend/storage/recordings/

# backend virtualenv (local install; never tracked)
backend/.venv/
