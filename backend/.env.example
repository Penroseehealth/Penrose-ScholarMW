DATABASE_URL=postgresql+asyncpg://penrose:penrose@localhost:5432/penrose_scholar
DATABASE_URL_SYNC=postgresql://penrose:penrose@localhost:5432/penrose_scholar
SECRET_KEY=change-me-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# --- AI providers -----------------------------------------------------------
# Tried in this order; leave a key blank to skip that provider. A failing
# provider falls through to the next one, so a 401/402/429 or timeout never
# stops the request while another provider is configured.
#
# Hugging Face needs Inference Providers credits (or a PRO plan) on the token
# account; without them the router answers 402. Cloudflare Workers AI and
# Groq have free tiers, so Cloudflare leads by default and Hugging Face is the
# first fallback. Allowed names: cloudflare, huggingface, openai, groq.
AI_PROVIDER_PRIORITY=["cloudflare","huggingface","openai","groq"]
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL=meta-llama/Llama-4-Scout-17B-16E-Instruct
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

CHROMA_PERSIST_DIR=./chroma_data
MEDIA_DIR=./media
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
ENVIRONMENT=development
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech / Voice Training Center
ENABLE_SPEECH=true
STT_PROVIDER=
TTS_VOICE=hannah
TTS_SPEED=1.0
TTS_PROVIDER_FALLBACK_ORDER=["groq", "freeai"]
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
FREEAI_API_KEY=
FREEAI_BASE_URL=https://api.freeai.com/v1
FREEAI_TTS_MODEL=tts-1
# Voice cloning: "openvoice" (local sidecar, keyless) or "elevenlabs" (hosted)
CLONE_PROVIDER=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_CLONE_MODE=instant
ELEVENLABS_DEFAULT_VOICE_ID=
OPENVOICE_SIDECAR_URL=http://127.0.0.1:8011
OPENVOICE_BASE_SPEAKER=EN-US
OPENVOICE_HEALTH_TIMEOUT_S=3.0
OPENVOICE_SYNTHESIZE_TIMEOUT_S=900.0

# Chat narration voice (app/voice/ Edge TTS path). A premade US/UK female
# catalog id: en-us-female | en-gb-female | en-in-female (see voice_catalog.py).
# Distinct from TTS_VOICE above, which drives the Groq Orpheus /speech path.
# Fallback when unknown/unavailable: built-in default en-gb-female, then the
# per-language Edge voice. Never raises.
NARRATION_VOICE_ID=en-gb-female
