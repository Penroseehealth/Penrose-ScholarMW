# Normalize all text files to LF (dart format + ruff expect LF)
* text=auto eol=lf

*.dart text eol=lf
*.py text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf

# Binary files (never normalize)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wasm binary
*.pdf binary
*.pptx binary
*.docx binary
*.exe binary
*.db binary
*.webp binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.otf binary
*.ttf binary