# Production environment — copy to .env and fill in values
DATABASE_URL=postgresql+asyncpg://penrose:PASSWORD@HOST:5432/penrose_scholar
DATABASE_URL_SYNC=postgresql://penrose:PASSWORD@HOST:5432/penrose_scholar
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
OPENAI_API_KEY=sk-your-production-key
OPENAI_MODEL=gpt-4o
CHROMA_PERSIST_DIR=/data/chroma
MEDIA_DIR=/data/media
CORS_ORIGINS=["https://scholar.mw","https://api.scholar.mw"]
ENVIRONMENT=production
